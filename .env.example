# Copy to .env and replace both values from Supabase Dashboard > Settings > API.
# Use project URL and publishable/anon key only. Never use service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional Thai PromptPay mobile number (for payment QR generation).
VITE_PROMPTPAY_ID=0812345678
